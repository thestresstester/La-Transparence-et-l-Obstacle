	/* ************ Misc generic table elements ****************** */

	/* footer label left */
	.mso_fll{
		font-size: 7.0pt;
		color: #000000;
		FONT-FAMILY:  Tahoma;
		text-align : LEFT;
	}

	/* footer label right */
	.mso_flr{
		font-size: 7.0pt;
		color: #000000;
		FONT-FAMILY:  Tahoma;
		text-align : RIGHT;
	}

	/* footer label center */
	.mso_flc{
		font-size: 7.0pt;
		color: #000000;
		FONT-FAMILY:  Tahoma;
		text-align : CENTER;
	}

	/* footer cell aligned left - solid Line top border */
	TD.mso_fcl{
		border-top: 1px solid #DDDDDD;
		vertical-align : bottom;
		text-align : LEFT;
	}

	/* footer cell aligned right - solid Line top border */
	TD.mso_fcr{
		border-top: 1px solid #DDDDDD;
		vertical-align : bottom;
		text-align : RIGHT;
	}

	/* footer cell aligned center - solid Line top border */
	TD.mso_fcc{
		border-top: 1px solid #DDDDDD;
		vertical-align : bottom;
		text-align : CENTER;
	}

	.mso_fieldset {
		FONT-SIZE: 7pt;
		font-weight : normal;
		color : #CC9900;
		text-transform : uppercase;
		border-style : solid;
		border-width : 1px;
		border-color : #CC9900;
	}

	.mso_specialbkgrd {
		background-color : #D6D3CE;
		font-size : 8.0pt;
		font-weight : normal;
		color : Black;
	}

	/* Some RK uses it as a page header */
	.mso_headline  {
		color: #000000;
		font-weight: 800;
		font-size: 90%;
	}

	/* Used for positioning the thumbnail on a news headline (top news) */
	.mso_news-thumbnail {
		padding-right : 5px;
		padding-top : 12px;
	}

	/* the news headline class (top news) */
	.mso_newsheadline, .mso_newsheadline {
		FONT-SIZE: 90%;
		font-weight: bold;
		COLOR: #000000;
		FONT-FAMILY:  Tahoma, Arial, sans-serif ;
		text-align : left;
		position: relative;
		top: -3px;
	}

	.mso_chartbkgrd {
		background-color: #ECE8E3;
		border-color: #FFFFCC #CCCC99 #CCCC99 #FFFFCC;
		border-style: solid;
		border-top-width: 1px;
		border-right-width: 1px;
		border-bottom-width: 1px;
		border-left-width: 1px;
	}

	.mso_selectform, .mso_selectlist {
		font-family: Verdana, sans-serif;
		color: #000000;
		background-color: #E9E0EB;
		font-style: normal;
		font-weight: normal;
		padding: 2px;
	}

	.mso_calendar {
		font-family: Verdana, Arial, Helvetica, sans-serif;
		font-size: 8.0pt;
		text-align: right;
		border: 1px #CCCCCC solid
	}

	.mso_calendarhead {
		font-weight: bold;
		color: #FFFFFF;
		background-color: #999999;
		text-align: center
	}

	.mso_sampleBackground {
		background-image: url(SampleTile.mso_gif);
	}

	.mso_raisedtextbox  {
		color: #000000;
		font-size: 8.0pt;
		background-color: #FFFFFF;
		border-style: solid;
		border-bottom-width: 1px;
		border-top-width: 0px;
		border-right-width : 1px;
		border-left-width : 0px;
		border-bottom-color: #000000;
		border-right-color: #000000;
	}

	.mso_dropdownmenu {
		color: #000000;
		font-size: 8.0pt;
		background-color: #ffffff;
		padding-right:2px;
		font-family: Verdana;
		font-weight : normal;

	}


	.mso_datasource {
		text-align: right;
	}

	.mso_pib {
		font-size: 8.0pt;
		border-top-width: 1px;
		border-right-width: 0px;
		border-bottom-width: 1px;
		border-left-width: 1px;
		border-top-style: dotted;
		border-right-style: none;
		border-bottom-style: dotted;
		border-left-style: none;
	}

	.mso_tld-c {
		text-align : LEFT;
		vertical-align : baseline;
		margin-top: -12px;
	}

	.mso_tld-r, .mso_actionButtonIconSpan, .mso_abis {
		text-align:right;
		xpadding-right:1px;
		padding-left:1px;
		vertical-align:bottom;
		padding-bottom:1px;
		border-bottom:1px solid #9B9B9B;
		width:100%
	}

	/* in subviewhead only if more than one alignment is needed */
	.mso_tld-c {
		text-align : CENTER;
		vertical-align : baseline;
		margin-top: -12px;
	}

	/* Newly created for images in the subviewhead cell */
	IMG.mso_tli-r {
		cursor: pointer;
		margin: 1px;
		/*padding-right:8px;
		padding-top:4px; */
		background-color: transparent;
		vertical-align : top;
	}

	/* ******* End Of Table Template Specific Classes ******* */


	/* Input Selectors */

	INPUT.mso_disabled {
		background-color: #fcfcfc;
		color: #7f7f7f;
	}

	INPUT.mso_modal {
		background-color: Yellow;
	}

	INPUT.mso_radioButton, INPUT.mso_rb  {
		font-size : 8.0pt;
		font-weight : bold;
		color : #000000;
	}

	.mso_radioText, .mso_radiotext {
		font-size : 8.0pt;
		font-weight : bold;
		color : #000000;
		vertical-align: baseline;
		position: relative;
		top: -1px;
	}

	SELECT.mso_disabled {
		background-color: #fcfcfc;
		color: #7f7f7f;
	}

	INPUT.mso_acdd, INPUT.mso_activecalculateddatadisabled {
		font-style: italic;
		background-color: #fcfcfc;
	}
	/* Active calculated data */
	INPUT.mso_acd, INPUT.mso_activecalculateddata {
		font-style: italic;
	}

	input.mso_textBox, input.mso_textbox, input.mso_textboxl  {
		font-size : 8.0pt;
		font-family: Tahoma;
		font-weight : normal;
		color : #000000;
		text-align: LEFT;
		vertical-align: middle;
		border:1px solid #7F9DB9;
	}

	input.mso_textboxr {
		font-size : 8.0pt;
		font-family: Tahoma;
		font-weight : normal;
		color : #000000;
		text-align: RIGHT;
		vertical-align: bottom;
	}

	input.mso_textboxndr {
		font-size: 8.0pt;
		font-family: Tahoma;
		text-align : RIGHT;
		color: #000000;
		vertical-align: bottom;
	}

	input.mso_textboxndl {
		font-size: 8.0pt;
		font-family: Tahoma;
		text-align : LEFT;
		color: #000000;
		vertical-align: bottom;
	}

	input.mso_textboxddr {
		FONT-SIZE: 8.0pt;
		COLOR: #000000;
		FONT-FAMILY:  Tahoma;
		text-align : RIGHT;
		vertical-align: bottom;
	}

	input.mso_textboxddl {
		FONT-SIZE: 8.0pt;
		COLOR: #000000;
		FONT-FAMILY:  Tahoma;
		text-align : LEFT;
		vertical-align: bottom;
	}

	.mso_button {
		color: #000099;
		font-family:Tahoma;
		font-size: 8.0pt;
		background-color: #94AEC6;
		z-index: 2;
		border-top-width: 1px;
		border-right-width: 1px;
		border-bottom-width: 1px;
		border-left-width: 1px;
		border-top-style: solid;
		border-right-style: solid;
		border-bottom-style: solid;
		border-left-style: solid;
		border-top-color: #99CCFF;
		border-right-color: #003366;
		border-bottom-color: #003366;
		border-left-color: #99CCFF;
		cursor: pointer;
	}

	INPUT.mso_button1, BUTTON.mso_button1 {
		font-family:Tahoma;
		font-size:11px;
		color: #000099;
		padding-left:3px;
		padding-right:3px;
		text-align:center;
		cursor:pointer;
	}

	INPUT.mso_button1-d, BUTTON.mso_button1-d {
		font-family:Tahoma;
		font-size:11px;
		color: #000099;
		padding-left:3px;
		padding-right:3px;
		text-align:center;
		cursor:default;
	}

	INPUT.mso_button1-b, INPUT.mso_button1-bold {
		font-family:Tahoma;
		font-size:11px;
		color: #000099;
		padding-left:3px;
		padding-right:3px;
		font-weight:bold;
		text-align:center;
		cursor:pointer;
	}

	INPUT.mso_button1-b-d, INPUT.mso_button1-bold-disabled {
		font-family:Tahoma;
		font-size:11px;
		color: #000099;
		padding-left:7px;
		padding-right:7px;
		font-weight:bold;
		text-align:center;
		cursor:default;
	}

	DIV.mso_chls, SPAN.mso_chls, DIV.mso_chrs, SPAN.mso_chrs, DIV.mso_chcs, SPAN.mso_chcs {
		cursor: pointer;
		vertical-align: bottom;
		border:0;
		margin:0;
	}

	IMG.mso_button {
		cursor: pointer;
		align: absmiddle;
		border:0;
		margin:0;
	}

	IMG.mso_sort {
	border:none;
	}

	/* FI Web views specific classes */

	@media print {
		.mso_sOverflowDIV {OVERFLOW:visible; WIDTH:100%;}
	}

	@media screen {
		.mso_sOverflowDIV {OVERFLOW:auto; WIDTH:100%; }
	}

	/* should key data bolding be hard coded? */
	DIV.mso_keydata  {
		font-weight: bold;
	}

	/* End of FI specific classes */


	/* ***** Newest classes for templates - need to document ***** */
	.mso_navResults {
		background-color: #E5E9EF;
		font-size : 7.0pt;
		font-family: Verdana;
		font-weight : bold;
		color : #000000;
		text-align: LEFT;
		padding-right:3px;
		padding-left:3px;
		border-bottom: 1px solid #FFFFFF;
		border-left: 1px solid #FFFFFF;
	}

	.mso_navControls {
		text-align: RIGHT;
		padding-right:3px;
		vertical-align:middle;
		border-bottom: 1px solid #FFFFFF;
		xborder-top: 1px solid #FFFFFF;
	}
	/* Navigation row for components with 2 tables incapsulated within a fieldset */
	.mso_navRow-d {
		background-color: #E5E9EF;
		border-left:1px solid #FFFFFF;
	}

	.mso_navRow {
		background-color: #E5E9EF;
		vertical-align : middle;
		border-bottom: 1px solid #FFFFFF;
	}
	TABLE.mso_innerInner-l{
		margin-left:10px;
	}
	/* These 2 are for market data template left and right inner tables for border style */
	TABLE.mso_inner-l, TABLE.mso_inner-left{
		border-right:1px solid #DDDDDD;
	}

	TABLE.mso_inner-r, TABLE.mso_inner-right{
		border-left:1px solid #DDDDDD;
	}

	/* Navigation row for components with 1 table incapsulated within a fieldset */
	TR.mso_navRow {
		/*height:28px;*/
	}

	/* for positioning of the seperator in the inter-component navigation */
	SPAN.mso_navBars {
		vertical-align:top;
		position:relative;
		top:1px;
	}

	DIV.mso_rsnl, DIV.mso_resultssetnavigationlinks{
		position:relative;
		top:-2px;
	}

	/* for positioning of the input row at the top of a component (if applicable)  */
	.mso_inputRow  {
		background-color: #E5E9EF;
		position: relative;
		height: 31px;
		vertical-align:middle;
	}
	/*
	A, A:active, A:visited{
		font-family: Tahoma;
		font-weight : normal;
		color : #000099;
		text-decoration:none;
	}

	A:hover{
		font-family: Tahoma;
		font-weight : normal;
		color : #ff9900;
		text-decoration:underlined;
	}
	*/
	a.mso_cn, a.mso_componentnavigation, a.mso_cn:active, , a.mso_cn:visited {
		font-size:8.0pt;
		font-family: Tahoma;
		font-weight : bold;
		color : #000099;
	}
	a.mso_cn:hover, a.mso_componentnavigation:hover {
		font-size:8.0pt;
		font-family: Tahoma;
		font-weight : bold;
		color: #ff9900;
	}

	a.mso_cn-d, a.mso_cn-d:hover, a.mso_cn-d:active, a.mso_componentnavigation-disabled {
		font-size:8.0pt;
		font-family: Tahoma;
		font-weight : bold;
		color: #CCCCCC;
		cursor:default;
		text-decoration:none;
	}

	a.mso_cn-s, a.mso_cn-s:hover, a.mso_cn-s:active, a.mso_componentnavigation-selected {
		font-size:8.0pt;
		font-family: Tahoma;
		font-weight : bold;
		color: #000000;
		cursor:default;
		text-decoration:none;
	}

	a.mso_cn1, a.mso_componentnavigation1, a.mso_cn1:visited, a.mso_cn1:active {
		font-size:8.0pt;
		font-family: Tahoma;
		font-weight : normal;
		color : #000099;
		text-decoration : none;
	}

	a.mso_cn1:hover, a.mso_componentnavigation1:hover {
		font-size:8.0pt;
		font-family: Tahoma;
		font-weight : normal;
		color: #ff9900;
	}

	a.mso_gl, a.mso_genericlink, a.mso_gl:visited, a.mso_gl:active {
		color : #000099;
		text-decoration : none;
	}

	a.mso_gl:hover, a.mso_genericlink:hover {
		color: #ff9900;
		text-decoration:underline;
	}

	a.mso_gl-b, a.mso_genericlink-bold, a.mso_gl-b:visited, a.mso_gl-b:active {
		color : #000099;
		text-decoration : none;
		font-weight:bold;
	}

	a.mso_gl-b:hover, a.mso_genericlink-bold:hover {
		color: #ff9900;
		text-decoration:underline;
		font-weight:bold;
	}

	a.mso_ld, a.mso_linkdata, a.mso_ld:visited, a.mso_ld:active {
		color : #000099;
		font-weight:normal;
		text-decoration : none;
	}

	a.mso_ld:hover, a.mso_linkdata:hover {
		color: #ff9900;
		font-weight:normal;
		text-decoration:underline;
	}

	a.mso_ld-s, a.mso_linkdata-strong, a.mso_ld-s:visited, a.mso_ld-s:active {
		color : #000099;
		font-weight:bold;
		text-decoration : none;
		font-weight:bold;
	}

	a.mso_ld-s:hover, a.mso_linkdata-s:hover {
		color: #ff9900;
		font-weight:bold;
		text-decoration:underline;
		font-weight:bold;
	}

	.mso_rsn, a.mso_resultssetnavigation, a.mso_rsn:visited, a.mso_rsn:active {
		font-size:7.0pt;
		font-family: Tahoma;
		font-weight : bold;
		color : #666666;
		text-decoration : none;
	}

	a.mso_rsn:hover, a.mso_resultssetnavigation:hover {
		font-size:7.0pt;
		font-family: Tahoma;
		font-weight : bold;
		color: #ff9900;
	}

	a.mso_rsn-a, a.mso_resultssetnavigation-active, a.mso_rsn-a:visited, a.mso_rsn-a:active, SPAN.mso_rsn-a {
		font-size:7.0pt;
		font-family: Tahoma;
		font-weight : bold;
		color : #000000;
		text-decoration : none;
		cursor:default;
	}

	a.mso_rsn-d, a.mso_rsn-d:hover, a.mso_rsn-d:active, a.mso_rsn-d:visited, a.mso_resultssetnavigation-disabled {
		font-size:7.0pt;
		font-family: Tahoma, Arial, sans-serif;
		font-weight : bold;
		color: #CCCCCC;
		cursor:default;
		text-decoration:none;
	}

	a.mso_cn1-d, a.mso_cn1-d:hover, a.mso_cn1-d:visited, a.mso_cn1-d:active {
		font-size:7.0pt;
		font-family: Tahoma;
		font-weight : normal;
		color : #CCCCCC;
		cursor:default;
		text-decoration: none;
	}

	.mso_cn-arrows-double, .mso_cn-a-d{
		font-family: Tahoma;
		font-size:90%;
		font-weight : bold;
		color : #FF6600;
		text-decoration:none;
	}

	.mso_cn-arrows-single, .mso_cn-a-s {
		font-weight : bold;
		color : #FF6600;
		text-decoration:none;
	}

	.mso_cn-arrows-double-d, .mso_cn-arrows-double-disabled{
		font-family: Tahoma, Arial, sans-serif;
		font-weight : normal;
		color : #CCCCCC;
		text-decoration:none;
	}

	.mso_cn-a-s-d,.mso_cn-arrows-single-d, .mso_cn-arrows-single-disabled {
		font-family: Tahoma;
		font-weight : bold;
		color : #CCCCCC;
		text-decoration:none;
	}

	.mso_pointer, .mso_hand {
		cursor: pointer;
		border:0px;
	}

	.mso_headerInfoRow {
		height:17px;
	}

	.mso_hid {
		font-size : 8.0pt;
		font-family: Tahoma;
		font-style: normal;
		font-weight : normal;
		background-color:#EEEEEE;
		color : #666666;
		text-align:right;
		padding-right : 4px;
		border-bottom:1px solid #FFFFFF;
		border-left:1px solid #FFFFFF;
	}
	/* Group (header) cell, use for all GC except top one */
	.mso_gc {
		background-color:#DFDFDF;
		border-top: solid 1px #ffffff;
	}

	.mso_gc-t {
		background-color:#DFDFDF;
	}

	/* used as the top group header cell in the Transaction comp */
	.mso_gc-t-s {
		height : 19px;
		vertical-align : bottom;
		position: relative;
		top: -4px;
	}

	.mso_gc1-d {
		height : 30px;
		position: relative;
		vertical-align : bottom;
		top: -4px;
	}

	/* color for chart cell for 360 consensus estimates */
	TD.mso_chartcell {
		background-color : #D3ECA5;
		font-weight : normal;
		border-bottom: 1px solid #ffffff;
		border-left: 1px solid #ffffff;
	}

	TD.mso_chartcell-l {
		background-color : #D3ECA5;
		font-weight : normal;
		border-bottom: 1px solid #ffffff;
	}

	.mso_lps, .mso_largepagesynopsis{
		font-family:Verdana;
		font-weight:bold;
		font-size:85%;
		text-align:left;
		padding-left:8px;
		padding-right:8px;
		padding-top:1px;
	}

	.mso_smc, .mso_synopsismiddlecell{
		background-color:#EFEFEF;
		vertical-align:top;
		border-right:1 solid #BDBDB8;
		border-left:1 solid #BDBDB8;
		border-bottom:1 solid #BDBDB8;
	}

	.mso_s1c1r, .mso_synopsis1stcell1strow{
		background-color:#EFEFEF;
		vertical-align:top;
		border-left:1 solid #BDBDB8;
		padding-top:6px;
		height:1px;
	}

	.mso_s1c2r, .mso_synopsis1stcell2ndrow{
		background-color:#EFEFEF;
		vertical-align:top;
		border-left:1 solid #BDBDB8;
		border-bottom:1 solid #BDBDB8;
	}

	.mso_s1c2r-o, .mso_synopsis1stcell2ndrow-open{
		background-color:#EFEFEF;
		vertical-align:top;
		border-bottom:1 solid #BDBDB8;
	}

	.mso_s2cmr, .mso_synopsis2ndcellmiddlerow{
		background-color:#EFEFEF;
		vertical-align:top;
		border-left:1 solid #BDBDB8;
		height:1px;
		text-align:left;
	}

	.mso_s2cmr-o, .mso_synopsis2ndcellmiddlerow-open{
		background-color:#EFEFEF;
		vertical-align:top;
		height:1px;
		text-align:left;
	}

	.mso_s3c1r, .mso_synopsis3rdcell1strow{
		background-color:#EFEFEF;
		vertical-align:top;
		border-right:1 solid #BDBDB8;
		padding-top:6px;
		height:1px;
	}

	.mso_s3c2r, .mso_synopsis3rdcell2ndrow{
		background-color:#EFEFEF;
		vertical-align:top;
		border-right:1 solid #BDBDB8;
		height:1px;
		text-align:left;
	}


	.mso_s3cbr, .mso_synopsis3rdcellbottomrow{
		background-color:#EFEFEF;
		vertical-align:top;
		border-right:1 solid #BDBDB8;
		border-bottom:1 solid #BDBDB8;
	}

	.mso_srhl, .mso_synopsisrowheaderleft   {
		COLOR: #333333;
		FONT-FAMILY: Verdana;
		FONT-SIZE: 7.0pt;
		FONT-WEIGHT: bold;
		TEXT-ALIGN: LEFT;
		padding-left:4px;
		padding-right:2px;
	}

	.mso_srhr, .mso_synopsisrowheaderright   {
		COLOR: #333333;
		FONT-FAMILY: Verdana;
		FONT-SIZE: 7.0pt;
		FONT-WEIGHT: bold;
		TEXT-ALIGN: RIGHT;
		padding-left:2px;
		padding-right:2px;
	}

	.mso_srhc, .mso_synopsisrowheadercenter   {
		COLOR: #333333;
		FONT-FAMILY: Verdana;
		FONT-SIZE: 7.0pt;
		FONT-WEIGHT: bold;
		TEXT-ALIGN: CENTER;
		padding-left:2px;
		padding-right:2px;
	}
	
	.cell01r {text-align:right;border-top:solid 1px #E5EBF4;mso-number-format: "\#\,\#\#0_\)\;\[Red\]\\\(\#\,\#\#0\\\)"}
	.cell01r0 {text-align:right;border-top:solid 1px #E5EBF4;mso-number-format: "\#\,\#\#0_\)\;\[Red\]\\\(\#\,\#\#0\\\)"}
	.cell01r1 {text-align:right;border-top:solid 1px #E5EBF4;mso-number-format: "\#\,\#\#0\.0_\)\;\[Red\]\\\(\#\,\#\#0\.0\\\)"}
	.cell01r2 {text-align:right;border-top:solid 1px #E5EBF4;mso-number-format: "\#\,\#\#0\.00_\)\;\[Red\]\\\(\#\,\#\#0\.00\\\)"}
