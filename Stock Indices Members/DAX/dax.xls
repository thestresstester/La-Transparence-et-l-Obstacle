	TABLE.datatable {
		table-layout: auto;
		font: 11px Tahoma;
		border-collapse:collapse;
	}

	TR.row-e{
		background-color : #C0C0C0;
		font-weight : normal;
	}

	TR.row-e, TR.row-o {
		vertical-align:top;
	}

	TR.hr {
		color:#000000;
		font-family: Tahoma;
		font-weight : bold;
		font-size:8.0pt;
		vertical-align:bottom;
		padding-bottom:2px;
		background-color : 	#ccccff;
	}

	.datatabletitle { font: bold 11px Tahoma; padding: 10px 1px 2px 1px; vertical-align: bottom; border-bottom: 1px solid #9B9B9B; }


	.mso_title{
		color:#000000;
		font-family: Tahoma;
		font-weight : bold;
		font-size:8.0pt;
		padding-right:1px;
		padding-left:1px;
		vertical-align:bottom;
		padding-bottom:2px;
		border-bottom:1px solid #9B9B9B;
		width:100%;
	}

	.mso_stitle, .mso_synopsistitle{
		color:#000000;
		font-family: Tahoma;
		font-weight : bold;
		font-size:8.0pt;
		vertical-align:bottom;
		padding-bottom:2px;
	}

